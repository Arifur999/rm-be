NODE_ENV=development
PORT=5000

# Neon: pooled connection string (host contains "-pooler") for the app
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Neon: direct connection string (no "-pooler") for prisma migrate
DIRECT_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Frontend origin(s), comma separated
FRONTEND_URL=http://localhost:3000

# Super admin. Created on first login / `npm run seed` if no admin exists yet.
# Change the password from the site's settings afterwards.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# How long one login lasts
SESSION_DAYS=30

# Max DB connections per server instance (local prisma dev: 1)
DB_POOL_MAX=5
